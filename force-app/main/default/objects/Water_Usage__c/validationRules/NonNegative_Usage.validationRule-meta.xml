<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NonNegative_Usage</fullName>
    <active>true</active>
    <description>Usage cannot be negative</description>
    <errorConditionFormula>Volume_Liters__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Volume_Liters__c</errorDisplayField>
    <errorMessage>Usage cannot be negative.</errorMessage>
</ValidationRule>
